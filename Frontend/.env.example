############################################################
# PusulaFit Flutter — Build-Time Dart Define Değerleri
# Bu dosyayı commit'leme. Build komutlarında --dart-define kullan.
############################################################

# ── BACKEND API ───────────────────────────────────────────
API_BASE_URL=https://ibbwfkjrmxdksnalivum.supabase.co/functions/v1

# ── SENTRY ────────────────────────────────────────────────
# sentry.io > Projects > DSN
SENTRY_DSN=https://xxxx@oxxxx.ingest.sentry.io/xxxx

# ── LEGAL URLS ────────────────────────────────────────────
APP_PRIVACY_URL=https://seninadrsin.com/privacy
APP_TERMS_URL=https://seninadrsin.com/terms
APP_SUPPORT_URL=https://seninadrsin.com/support
APP_PRIVACY_EMAIL=privacy@pusulafit.app
APP_LEGAL_EMAIL=legal@pusulafit.app

# ── GOOGLE SIGN-IN (Android için zorunlu, iOS plist'ten okur) ────────────────
# Web/server client id (Google Cloud Console → OAuth 2.0 → Web application)
GOOGLE_SERVER_CLIENT_ID=976465421947-2q2ao1vogl1tfmlvkso0d7tv60b3m0e0.apps.googleusercontent.com
# iOS client id (Google Cloud Console → OAuth 2.0 → iOS)
GOOGLE_IOS_CLIENT_ID=976465421947-sgglhdo3j4v30957u6j00279qteb5f36.apps.googleusercontent.com

# ── APPLE SIGN-IN (Android için zorunlu, iOS entitlement'tan okur) ────────────
# APPLE_SERVICE_ID=com.eneskotay.fitnessapp.web   # → Apple Developer → Service IDs
# APPLE_REDIRECT_URI=https://api.pusulafit.com/auth/apple/callback

############################################################
# Kullanım:
#   flutter build ipa \
#     --dart-define=API_BASE_URL=https://ibbwfkjrmxdksnalivum.supabase.co/functions/v1 \
#     --dart-define=SENTRY_DSN=https://... \
#     --dart-define=GOOGLE_IOS_CLIENT_ID="..." \
#     --dart-define=GOOGLE_SERVER_CLIENT_ID="..." \
#     --dart-define=APP_PRIVACY_URL=https://seninadrsin.com/privacy \
#     --dart-define=APP_TERMS_URL=https://seninadrsin.com/terms \
#     --dart-define=APP_SUPPORT_URL=https://seninadrsin.com/support
#
# Backend secrets (Supabase Edge Functions > Secrets):
#   JWT_SECRET_KEY               → zorunlu, min 32 karakter
#   AUTH_GOOGLE_ALLOWED_CLIENT_IDS → virgülle ayrılmış OAuth client ID'leri
#   AUTH_APPLE_ALLOWED_AUDIENCES   → iOS bundle ID (default: com.eneskotay.fitnessapp)
#   GEMINI_API_KEY               → AI Coach (ücretsiz tier)
#   CLAUDE_API_KEY               → AI Coach (premium tier)
#   IAP_APPLE_SHARED_SECRET      → App Store Connect → Subscriptions → Shared Secret
#   IAP_APPLE_BUNDLE_ID          → com.eneskotay.fitnessapp
#   IAP_APPLE_SANDBOX            → true (TestFlight), false (production)
#   IAP_GOOGLE_PACKAGE_NAME      → com.pusulafit.tracker
#   IAP_GOOGLE_SERVICE_ACCOUNT_JSON → Google Play → Setup → API Access → Service Account JSON
#   IAP_VERIFY_MODE              → dev (geliştirme) | strict (canlı)
############################################################
